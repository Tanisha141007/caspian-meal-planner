# Caspian project key (dashboard.trycaspianai.com -> Authentication & keys)
CASPIAN_API_KEY=
CASPIAN_BASE_URL=https://api.trycaspianai.com

# LLM behind meal-plan generation + "Ask AI" free-text parsing.
# "gemini" (default): free tier, no card, no expiry - get a key at
# aistudio.google.com (Google AI Studio, NOT Vertex AI - Vertex needs a
# billed GCP project, AI Studio doesn't).
# "anthropic": Claude, costs money - only if you set this explicitly.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# "sms" (default - the real target channel) or "whatsapp" (not yet live on
# Caspian's gateway per their own SKILL.md as of Aug 2026 - see
# scripts/start_whatsapp_onboarding.py before flipping this)
CASPIAN_CHANNEL=sms

# Your own Twilio account (SMS is bring-your-own-number on Caspian)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+1XXXXXXXXXX

# SQLite locally (default) or Postgres in prod, e.g. a Supabase connection
# string: postgresql://postgres:<password>@<host>:5432/postgres
# `alembic upgrade head` and the app both read this same var, so migrations
# always target whatever DB you're actually running against.
DATABASE_URL=sqlite:///./caspian_meals.db

# Local timezone used to schedule the weekly / monthly / daily jobs
APP_TIMEZONE=Asia/Kolkata

# Supabase project (auth). Verification is against the project's public
# JWKS (app/api/deps.py), not a shared secret - nothing else to configure.
SUPABASE_URL=
