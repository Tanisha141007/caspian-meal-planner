# Caspian project key (dashboard.trycaspianai.com -> Authentication & keys)
CASPIAN_API_KEY=
CASPIAN_BASE_URL=https://api.trycaspianai.com

# LLM behind meal-plan generation + "Ask AI" free-text parsing.
# "gemini" (default): free tier, no card, no expiry - get a key at
# aistudio.google.com (Google AI Studio, NOT Vertex AI - Vertex needs a
# billed GCP project, AI Studio doesn't).
# "anthropic": Claude, costs money - only if you set this explicitly.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# "telegram" (default - free, no card; bot via @BotFather, see below),
# "sms" (Twilio/Telnyx - confirmed both gate real custom-text SMS behind
# adding billing, trial tiers are template-only), or "whatsapp" (not yet
# live on Caspian's gateway per their own SKILL.md as of Aug 2026 - see
# scripts/start_whatsapp_onboarding.py before flipping this)
CASPIAN_CHANNEL=telegram

# Free bot token from @BotFather on Telegram (no card, ever). The bot can't
# message someone first - platform-wide restriction - so onboarding a cook
# means: give them the household's link_code (app/models.py), they message
# your bot with it, app/messaging/handler.py links them automatically.
TELEGRAM_BOT_TOKEN=

# Weekly family email (Monday): the whole week's chart + dishes they could
# add, sent to Household.owner_email. This is a SECOND Caspian connection
# alongside CASPIAN_CHANNEL above - the cook still gets their daily message
# on Telegram/SMS, the family gets the week by email. Email is free on
# Caspian and, unlike Telegram, can cold-start a conversation, which is why
# the family never has to write in first.
# Username picks the mailbox: mealplanner@agents.trycaspianai.com. Set
# CASPIAN_EMAIL_DOMAIN only if you've verified a custom domain.
CASPIAN_EMAIL_USERNAME=mealplanner
CASPIAN_EMAIL_DOMAIN=
# Local-time HH:MM the Monday email goes out, and how many suggestions it
# carries. Must be after Sunday 20:00 (when the plan it mails is generated).
WEEKLY_EMAIL_TIME=08:00
WEEKLY_EMAIL_SUGGESTIONS=6

# Your own Twilio account, if you switch CASPIAN_CHANNEL back to "sms"
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+1XXXXXXXXXX

# SQLite locally (default) or Postgres in prod, e.g. a Supabase connection
# string: postgresql://postgres:<password>@<host>:5432/postgres
# `alembic upgrade head` and the app both read this same var, so migrations
# always target whatever DB you're actually running against.
DATABASE_URL=sqlite:///./caspian_meals.db

# Local timezone used to schedule the weekly / monthly / daily jobs
APP_TIMEZONE=Asia/Kolkata

# Supabase project (auth). Verification is against the project's public
# JWKS (app/api/deps.py), not a shared secret - nothing else to configure.
SUPABASE_URL=
