# Caspian project key (dashboard.trycaspianai.com -> Authentication & keys)
CASPIAN_API_KEY=

# Claude API key (console.anthropic.com)
ANTHROPIC_API_KEY=

# "sms" (default) uses Caspian's live phone channel with your own Twilio number.
# WhatsApp is coming soon on the hosted gateway; do not set this to whatsapp
# until /v1/channels lists it as live.
CASPIAN_CHANNEL=sms

# Your own Twilio account (SMS is bring-your-own-number on Caspian)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+1XXXXXXXXXX

# SQLite file used for households, recipes, meal plans, feedback
DATABASE_URL=sqlite:///./caspian_meals.db

# Local timezone used to schedule the weekly / monthly / daily jobs
APP_TIMEZONE=Asia/Kolkata
